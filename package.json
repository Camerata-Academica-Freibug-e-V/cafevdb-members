{
  "name": "cafevdbmembers",
  "version": "0.0.4",
  "private": true,
  "description": "Expose a member's data record for the respective member",
  "homepage": "https://github.com/rotdrop/cafevdb-members.git",
  "bugs": {
    "url": "https://github.com/rotdrop/cafevdb-members.git"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rotdrop/cafevdb-members.git"
  },
  "license": "agpl",
  "author": "Claus-Justus Heine <himself@claus-justus-heine.de>",
  "type": "module",
  "scripts": {
    "build": "vite --mode production build",
    "dev": "vite --mode development build",
    "test": "vitest run",
    "test:build-config": "node --test tests/frontend/vite-config.test.mjs",
    "test:member-data": "node --experimental-test-module-mocks --test tests/frontend/member-data.test.mjs",
    "watch": "vitest watch"
  },
  "prettier": {
    "singleQuote": true,
    "plugins": [
      "@prettier/plugin-php"
    ],
    "overrides": [
      {
        "files": "*.php",
        "options": {
          "parser": "php"
        }
      }
    ]
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "eslintIgnore": [
    "src/toolkit/util/ajax.js",
    "src/toolkit/util/dialogs.js",
    "src/toolkit/util/file-download.js",
    "src/toolkit/util/jquery.js"
  ],
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/babel-config": "^1.3.0",
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/dialogs": "^7.0.2",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/files": "^4.1.0-beta.2",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "*",
    "@nextcloud/moment": "^1.3.5",
    "@nextcloud/router": "*",
    "@nextcloud/vite-config": "^3.0.0-beta.1",
    "@nextcloud/vue": "^9.10.0",
    "@prettier/plugin-php": "^0.25.0",
    "@rotdrop/nextcloud-vue-components": "github:rotdrop/nextcloud-vue-components",
    "@types/deep-equal": "^1.0.4",
    "@vue/tsconfig": "^0.9.1",
    "axios": "^1.19.0",
    "deep-equal": "^2.2.3",
    "esbuild": "^0.28.2",
    "js-md5": "^0.9.2",
    "material-icons": "^1.13.14",
    "pinia": "^4.0.3",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "stacktrace-gps": "github:stacktracejs/stacktrace-gps#62f6967fc85e6fdd5fb9cea1a056b935d9b07a9a",
    "stacktrace-js": "^2.0.2",
    "typescript": "^6.0.0",
    "vite": "^8.3.1",
    "vite-plugin-svgo": "^3.0.1",
    "vue": "^3.5.41",
    "vue-material-design-icons": "^5.3.1",
    "vue-router": "^5.2.0",
    "walkjs": "^6.0.1",
    "xml2js": "*"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "core-js@3.50.0": true,
    "github:stacktracejs/stacktrace-gps#62f6967fc85e6fdd5fb9cea1a056b935d9b07a9a": true,
    "uuid@14.0.2": true
  }
}
